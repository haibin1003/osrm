# Stage 1: Build
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY osrm-backend/pom.xml .
COPY osrm-backend/src ./src
RUN mvn clean package -DskipTests -q

# Stage 2: Run
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app/osrm-backend

COPY --from=build /build/target/osrm-backend-*.jar app.jar
COPY osrm-deploy /app/osrm-deploy

EXPOSE 8080

ENTRYPOINT ["java", \
  "-jar", "app.jar", \
  "-Dspring.profiles.active=prod", \
  "-Duser.timezone=Asia/Shanghai", \
  "-Xms256m", "-Xmx512m"]
